# Copy this file to `.env` and fill in your key(s).
#   cp .env.example .env
#
# The labs read these via python-dotenv (see shared/llm.py). `.env` is gitignored.

# Anthropic Claude — the default provider for all labs.
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: OpenAI — only needed if you switch the LLM client to the OpenAI adapter.
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional overrides (sensible defaults live in shared/llm.py).
# ASL_DEFAULT_MODEL=claude-sonnet-4-6
# ASL_CHEAP_MODEL=claude-haiku-4-5
